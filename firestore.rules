rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Students collection — read/write allowed for authentication & voting status updates
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Teachers collection — read/write allowed for authentication & voting status updates
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Candidates collection — read/write allowed for candidate management & vote tallies
    match /candidates/{candidateId} {
      allow read, write: if true;
    }

    // System config collection — read/write allowed for global voting status (Polls Open/Closed)
    match /system/{configId} {
      allow read, write: if true;
    }

    // Votes collection — create & read only (immutable vote log, cannot be edited or deleted by clients)
    match /votes/{voteId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Deny all other unhandled collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
